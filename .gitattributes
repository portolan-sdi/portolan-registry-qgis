# Keep translation inputs and text outputs at LF on every checkout.
*.md text eol=lf
*.po text eol=lf
*.pot text eol=lf linguist-generated=true
portolan_registry_qgis/metadata.txt text eol=lf

# scripts/i18n.py update compiles these from messages.po. The plugin zip
# needs them, and qgis-plugin-ci packages tracked files only.
*.mo binary linguist-generated=true
